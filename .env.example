# ========================================================
# IEQ - Sistema de Gestão de Células e Mídia
# Arquivo de Exemplo de Variáveis de Ambiente (.env)
# ========================================================

# Portas de Exposição
FRONTEND_PORT=80
BACKEND_PORT=3001
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# PostgreSQL
POSTGRES_DB=ieq
POSTGRES_USER=ieq
POSTGRES_PASSWORD=ieqpassword

# Redis
REDIS_PASSWORD=ieqredis

# MinIO
MINIO_ROOT_USER=ieqminio
MINIO_ROOT_PASSWORD=ieqminio123
MINIO_BUCKET=ieq-files

# Autenticação JWT (use senhas seguras com mais de 32 caracteres em produção)
JWT_SECRET=substitua_por_segredo_jwt_aleatorio_32_chars!
JWT_REFRESH_SECRET=substitua_por_segredo_refresh_aleatorio_32_chars!

# Chave Criptografia AES-256 para Backup (exatamente 32 caracteres)
BACKUP_ENCRYPTION_KEY=chave_secreta_com_32_caracteres!
BACKUP_RETENTION_DAYS=7

# Cópia Nuvem S3-Compatível (Cloudflare R2 / Backblaze B2 - Opcional)
CLOUD_S3_ENDPOINT=
CLOUD_S3_BUCKET=
CLOUD_S3_ACCESS_KEY=
CLOUD_S3_SECRET_KEY=

# URL da API para o Frontend (React/Vite)
VITE_API_URL=http://localhost:3001
