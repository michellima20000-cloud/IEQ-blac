# ========================================================
# IEQ - Sistema de Gestão de Células e Mídia
# Arquivo de Exemplo de Variáveis de Ambiente (.env)
# ========================================================

# Portas de Exposição
FRONTEND_PORT=80
BACKEND_PORT=3001
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# PostgreSQL
POSTGRES_DB=ieq
POSTGRES_USER=ieq
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password

# Redis
REDIS_PASSWORD=replace-with-a-strong-redis-password

# MinIO
MINIO_ROOT_USER=replace-with-minio-user
MINIO_ROOT_PASSWORD=replace-with-a-strong-minio-password
MINIO_BUCKET=ieq-files

# Autenticação JWT (use senhas seguras com mais de 32 caracteres em produção)
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-another-random-secret-of-at-least-32-characters

# Chave Criptografia AES-256 para Backup (exatamente 32 caracteres)
BACKUP_ENCRYPTION_KEY=chave_secreta_com_32_caracteres!
BACKUP_RETENTION_DAYS=7

# Cópia Nuvem S3-Compatível (Cloudflare R2 / Backblaze B2 - Opcional)
CLOUD_S3_ENDPOINT=
CLOUD_S3_BUCKET=
CLOUD_S3_ACCESS_KEY=
CLOUD_S3_SECRET_KEY=

# URL da API para o Frontend (React/Vite)
VITE_API_URL=http://localhost:3001/api/v1

# Dono do sistema: apenas estes e-mails (perfil ADM) acessam /api/v1/admin e o bootstrap
ADMIN_OWNER_EMAILS=seu-email@exemplo.com
