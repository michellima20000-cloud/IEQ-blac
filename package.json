{
  "name": "ieq-black",
  "version": "1.0.0",
  "description": "Backend API para IEQ",
  "main": "dist/index.js",
  "scripts": {
    "postinstall": "npm --prefix backend install",
    "build": "npm --prefix backend run prisma:generate && cd backend && npx prisma db push --accept-data-loss",
    "start": "cd backend && npx tsx src/server.ts",
    "dev": "cd backend && npm run dev"
  },
  "keywords": ["express", "typescript", "api", "ieq"],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}

