# ──────────────────────────────────────────────
# IEQ - Variáveis de Ambiente
# ──────────────────────────────────────────────

PORT=3001
NODE_ENV=production
FRONTEND_URL="http://localhost"

# PostgreSQL
DATABASE_URL="postgresql://ieq:ieqpassword@postgres:5432/ieq?schema=public"

# Redis & Fila BullMQ
REDIS_URL="redis://:ieqredis@redis:6379"

# MinIO (Armazenamento Local S3-compatível)
MINIO_ENDPOINT="minio"
MINIO_PORT=9000
MINIO_USE_SSL="false"
MINIO_ACCESS_KEY="ieqminio"
MINIO_SECRET_KEY="ieqminio123"
MINIO_BUCKET="ieq-files"

# Autenticação JWT
JWT_SECRET="gere_um_segredo_jwt_aleatorio_min_32_chars"
JWT_REFRESH_SECRET="gere_outro_segredo_refresh_aleatorio_min_32_chars"

# Chave de Criptografia do Backup (AES-256-CBC, exatamente 32 caracteres)
BACKUP_ENCRYPTION_KEY="chave_secreta_com_32_caracteres!"
BACKUP_RETENTION_DAYS=7

# Cópia S3 na Nuvem (Cloudflare R2 ou Backblaze B2 - Plano Gratuito)
# Deixe em branco caso queira usar apenas MinIO local
CLOUD_S3_ENDPOINT=""
CLOUD_S3_BUCKET=""
CLOUD_S3_ACCESS_KEY=""
CLOUD_S3_SECRET_KEY=""
